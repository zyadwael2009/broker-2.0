# Copy to .env for local dev. Never commit .env.
FLASK_DEBUG=1
FLASK_APP=wsgi:app
SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-in-prod-too

# PostgreSQL. For local dev with Docker: postgres://postgres:postgres@localhost:5432/broker_dev
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/broker_dev

# Storage: "local" for Phase 1; "s3" wired in later phases.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
# Max upload size in MB (broker docs + listing photos share this limit).
MAX_UPLOAD_MB=20

# Comma-separated origins for CORS. Use * only in dev.
CORS_ORIGINS=*

# JWT lifetimes (seconds)
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Rate limiting (Flask-Limiter). Storage=memory:// for single-process
# dev; use redis://host:6379/0 for prod behind multiple workers.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_REGISTER=5 per hour
RATELIMIT_LOGIN=10 per minute
RATELIMIT_REFRESH=30 per minute
RATELIMIT_MESSAGES=30 per minute
RATELIMIT_RATINGS=3 per hour
RATELIMIT_REPORTS=5 per hour
RATELIMIT_VERIFY_PHONE=5 per minute
RATELIMIT_FORGOT_PASSWORD=3 per hour
RATELIMIT_RESET_PASSWORD=5 per minute
# Safety net for any endpoint without an explicit @limiter.limit — split
# with `;` for multiple thresholds. Route-level decorators override this.
RATELIMIT_DEFAULT=1000 per hour;100 per minute

# JWT revocation store — leave unset for in-memory (single worker),
# use redis://host:6379/1 in prod.
# JWT_REVOCATION_URI=redis://cache:6379/1

# Optional error tracking. Leave unset in dev/tests.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=broker-backend@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Phase 12 — SEO / public web view.
# Absolute URL used in sitemap.xml, canonical <link>, JSON-LD, and the
# share links the mobile client copies to clipboard. Leave unset in dev
# — the public routes fall back to request.host_url.
# PUBLIC_BASE_URL=https://your-domain.com

# Phase 12 — push notifications (FCM). Set to either a filesystem path
# to a Firebase service-account JSON file or the JSON itself. Leave
# unset for tests / local dev — the push helper silently no-ops.
# FIREBASE_CREDENTIALS_JSON=/etc/secrets/firebase-service-account.json

# ── Phase A2 — SMS provider (OTP delivery) ──────────────────────────
# Leave unset for dev — the code path logs the plaintext OTP to stdout
# with a [SMS-NOOP] prefix so you can complete flows without a real gateway.
# Set SMS_PROVIDER=twilio (or another future adapter) to enable real SMS.
# SMS_PROVIDER=twilio
# SMS_FROM_NUMBER=+15551234567
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OTP_TTL_MINUTES=10
# Dev convenience: include the plaintext OTP in the API response so
# client-side tests can complete the flow without reading logs. Refused
# in production by assert_production_safe.
# SMS_DEBUG_RETURN_CODE=true

# ── Phase A3 — legal / analytics / contact ───────────────────────────
# Privacy-friendly analytics on public pages. Cookie-free, no consent
# banner needed. Sign up at plausible.io, set the domain here.
# PLAUSIBLE_DOMAIN=wasit.app
# Rendered on the /privacy, /terms, and /contact pages. Without these,
# the templates render with blank sections. Update once the entity is
# registered and the real support channels are live.
SUPPORT_EMAIL=hello@wasit.eg
SUPPORT_WHATSAPP_URL=https://wa.me/201555000000
COMPANY_LEGAL_NAME=Wasit
COMPANY_ADDRESS=Cairo, Egypt

# ── Legal / PDPL ─────────────────────────────────────────────────────
# Bump when the broker verification consent text materially changes so
# audit trail can show which text version each broker agreed to.
PDPL_CONSENT_VERSION=1.0

# Flutter Web bundle location. Defaults to mobile/build/web/ relative to
# repo root. In production, set to an absolute path.
# WEBAPP_BUILD_DIR=/var/www/wasit/webapp

# Flask environment marker. In production, set to "production" — the
# app refuses to boot if any dev secret or wildcard CORS is still
# configured (see assert_production_safe in app/config.py).
# FLASK_ENV=production
