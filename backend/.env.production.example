# ─────────────────────────────────────────────────────────────────────
#  Wasit — PRODUCTION environment template
# ─────────────────────────────────────────────────────────────────────
#
#  Copy to your secrets store (Fly.io secrets, Doppler, 1Password Ops,
#  your provider's secret manager). NEVER commit this file with real
#  values filled in. The `.env` file that ships with the container
#  should be a symlink to your provider's secret mount.
#
#  Boot-time enforcement: `assert_production_safe` in app/config.py
#  refuses to start the app if any placeholder (like "dev-only-…" or
#  "change-me") is still present, or if CORS_ORIGINS is "*". If Flask
#  won't start after deploy, that check is telling you something.
#
#  Generate SECRET_KEY / JWT_SECRET_KEY with:
#      flask generate-secrets
# ─────────────────────────────────────────────────────────────────────

# ── Core Flask ──────────────────────────────────────────────────────
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_APP=wsgi:app

# ── Secrets ─────────────────────────────────────────────────────────
# Two distinct 48-byte URL-safe strings. NEVER reuse. NEVER commit.
SECRET_KEY=REPLACE_ME_run_flask_generate_secrets
JWT_SECRET_KEY=REPLACE_ME_run_flask_generate_secrets_DIFFERENT_VALUE

# ── Database ────────────────────────────────────────────────────────
# Managed Postgres from your hosting provider (Fly.io PG, Railway,
# Supabase, RDS, etc.). Must NOT contain localhost/127.0.0.1.
DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/wasit_prod
#
# PythonAnywhere Free tier uses MySQL — swap the URL to this shape
# (the '$' is literal, part of PA's DB naming convention):
# DATABASE_URL=mysql+pymysql://USER:PASS@USER.mysql.pythonanywhere-services.com/USER$wasit

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. NO wildcards in prod.
# Include every domain that will host the Flutter Web bundle.
CORS_ORIGINS=https://wasit.eg,https://www.wasit.eg

# ── Public base URL (used in sitemap, canonicals, JSON-LD) ─────────
PUBLIC_BASE_URL=https://wasit.eg

# ── Storage ─────────────────────────────────────────────────────────
# 'local' is fine for a first month if you also have persistent disk.
# For scale + CDN offload, plug in S3 or R2 by extending app/storage/.
STORAGE_BACKEND=local
UPLOAD_DIR=/data/uploads      # ← persistent volume mount
MAX_UPLOAD_MB=20

# ── JWT lifetimes ───────────────────────────────────────────────────
JWT_ACCESS_TTL=3600           # 1 hour
JWT_REFRESH_TTL=2592000       # 30 days

# ── Rate limiting ───────────────────────────────────────────────────
# Redis-backed so limits stay consistent across worker processes.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=redis://REDIS_HOST:6379/0
RATELIMIT_REGISTER=5 per hour
RATELIMIT_LOGIN=10 per minute
RATELIMIT_REFRESH=30 per minute
RATELIMIT_MESSAGES=30 per minute
RATELIMIT_RATINGS=3 per hour
RATELIMIT_REPORTS=5 per hour
RATELIMIT_VERIFY_PHONE=5 per minute
RATELIMIT_FORGOT_PASSWORD=3 per hour
RATELIMIT_RESET_PASSWORD=5 per minute
RATELIMIT_DEFAULT=1000 per hour;100 per minute

# JWT revocation store — Redis-backed so revocations propagate across
# worker processes. Use a separate DB from the ratelimit store.
JWT_REVOCATION_URI=redis://REDIS_HOST:6379/1

# ── Sentry error tracking ───────────────────────────────────────────
SENTRY_DSN=https://REPLACE_ME@o000000.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=wasit-backend@1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── SMS (Twilio) ────────────────────────────────────────────────────
# Get these from twilio.com/console. SMS_DEBUG_RETURN_CODE MUST be
# false in prod (assert_production_safe blocks otherwise).
SMS_PROVIDER=twilio
SMS_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=REPLACE_ME
OTP_TTL_MINUTES=10
SMS_DEBUG_RETURN_CODE=false

# ── Firebase Cloud Messaging (push) ─────────────────────────────────
# Path to service-account JSON, or the literal JSON string.
FIREBASE_CREDENTIALS_JSON=/etc/secrets/firebase-service-account.json

# ── Analytics ───────────────────────────────────────────────────────
# Sign up at plausible.io — cookie-free, no consent banner needed.
PLAUSIBLE_DOMAIN=wasit.eg

# ── Legal / contact info (rendered on /privacy, /terms, /contact) ──
SUPPORT_EMAIL=hello@wasit.eg
SUPPORT_WHATSAPP_URL=https://wa.me/201XXXXXXXXX
COMPANY_LEGAL_NAME=Wasit for Real Estate Technology
COMPANY_ADDRESS=Cairo, Egypt

# Bump when the broker verification consent text materially changes.
PDPL_CONSENT_VERSION=1.0

# ── Flutter Web bundle (only if serving via Flask; otherwise skip) ─
# WEBAPP_BUILD_DIR=/var/www/wasit/webapp
